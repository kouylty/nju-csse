# Optional overrides. init-db creates a persistent local secret when this is unset.
# YUXIAN_SECRET_KEY=<generate a random secret locally>
# Relative paths are resolved from the project root.
# YUXIAN_INSTANCE_PATH=instance
# YUXIAN_DATABASE=instance/yuxian.sqlite3
# YUXIAN_UPLOAD_DIR=instance/uploads
# YUXIAN_SESSION_TTL_SECONDS=28800
